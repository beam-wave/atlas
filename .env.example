# Copy to .env and fill in what you use. Only set the ones you need: an empty
# value can make a CLI try the wrong kind of login.

# Which backend new studies use: claude_cli, codex_cli, cursor_cli, gemini_cli, anthropic_api, mock
ATLAS_LLM_ADAPTER=claude_cli

# Claude subscription: run `claude setup-token` on your machine and paste the token.
# (Or log in inside the container instead: `make docker-login`.)
# CLAUDE_CODE_OAUTH_TOKEN=

# Cursor subscription: create an API key in Cursor's dashboard.
# CURSOR_API_KEY=

# Gemini: an API key from Google AI Studio (or log in inside the container).
# GEMINI_API_KEY=

# Codex: log in inside the container (`make docker-login`), or use an API key.
# OPENAI_API_KEY=

# Pay-as-you-go Claude API instead of a subscription.
# ANTHROPIC_API_KEY=

# Port on your machine (default 4000).
# ATLAS_PORT=4000
